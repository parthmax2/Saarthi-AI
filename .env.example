# Copy to .env and fill in. Existing keys may also live in code/.env.
# Do not commit real API keys.

# --- Data APIs ---
# Required for route planning, traffic simulation, and TomTom geocoding.
TomTom_api_key=your_tomtom_key

# Optional enrichments. The app degrades gracefully when these are blank.
calendarific_api_key=your_calendarific_key
Geoapify_API=your_geoapify_key
Ticketmaster_API=your_ticketmaster_key

# --- LLMs ---
# At least one key is needed for AI verdicts and Ask Saarthi.
GEMINI_API_KEY=your_gemini_key_from_aistudio.google.com
GROQ_API_KEY=your_groq_key_from_console.groq.com

# Comma-separated fallback chains, strongest model first.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- MongoDB Atlas (required for cache + commute history) ---
# Free M0 cluster: https://cloud.mongodb.com -> New Project -> Free tier
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saarthi?retryWrites=true&w=majority

# --- MongoDB MCP server for Ask Saarthi chat ---
# Local default uses Node.js/npx. Docker overrides this to the preinstalled binary.
MONGODB_MCP_COMMAND=npx
MONGODB_MCP_ARGS=-y,mongodb-mcp-server@latest,--readOnly
MONGODB_MCP_READ_ONLY=true

# Optional: set this only if MCP needs a different MongoDB connection string.
# When omitted, mongodb+srv MONGODB_URI is auto-converted for MCP.
MONGODB_MCP_URI=
